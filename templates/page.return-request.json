{
  "sections": {
    "main": {
      "type": "main-page",
      "blocks": {
        "title": {
          "type": "text",
          "name": "t:names.title",
          "settings": {
            "text": "<h1>{{ closest.page.title }}</h1>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "h2",
            "font": "var(--font-body--family)",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "content": {
          "type": "text",
          "name": "t:names.content",
          "settings": {
            "text": "{{ closest.page.content }}",
            "width": "100%",
            "max_width": "narrow",
            "alignment": "center",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        }
      },
      "block_order": [
        "title",
        "content"
      ],
      "settings": {
        "content_direction": "column",
        "gap": 32,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 40,
        "padding-block-end": 0
      }
    },
    "form": {
      "type": "section",
      "blocks": {
        "return_form": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "<div class=\"return-form\">\n{%- form 'contact', class: 'contact-form__form' -%}\n  {%- if form.posted_successfully? -%}\n    <div class=\"contact-form__success\">Thank you \u2014 your request has reached us. We'll reply within two working days with next steps.</div>\n  {%- endif -%}\n\n  {%- if form.errors -%}\n    <div class=\"contact-form__error\">Please check the highlighted fields and try again.</div>\n  {%- endif -%}\n\n  <div class=\"contact-form__form-row\">\n    <label class=\"visually-hidden\" for=\"ReturnForm-name\">Name</label>\n    <input type=\"text\" id=\"ReturnForm-name\" class=\"contact-form__input\" name=\"contact[name]\"\n      autocomplete=\"name\" value=\"{{ form.name }}\" placeholder=\"Name\" required>\n\n    <label class=\"visually-hidden\" for=\"ReturnForm-email\">Email</label>\n    <input type=\"email\" id=\"ReturnForm-email\" class=\"contact-form__input\" name=\"contact[email]\"\n      autocomplete=\"email\" spellcheck=\"false\" autocapitalize=\"off\" value=\"{{ form.email }}\"\n      placeholder=\"Email\" required>\n  </div>\n\n  <div class=\"contact-form__form-row\">\n    <label class=\"visually-hidden\" for=\"ReturnForm-order\">Order number</label>\n    <input type=\"text\" id=\"ReturnForm-order\" class=\"contact-form__input\" name=\"contact[Order number]\"\n      placeholder=\"Order number\" required>\n\n    <label class=\"visually-hidden\" for=\"ReturnForm-item\">Piece you're returning</label>\n    <input type=\"text\" id=\"ReturnForm-item\" class=\"contact-form__input\" name=\"contact[Item]\"\n      placeholder=\"Piece you're returning\" required>\n  </div>\n\n  <label class=\"visually-hidden\" for=\"ReturnForm-reason\">Reason</label>\n  <select id=\"ReturnForm-reason\" class=\"contact-form__input\" name=\"contact[Reason]\">\n    <option value=\"\" disabled selected>Reason for return</option>\n    <option>Sizing \u2014 too small</option>\n    <option>Sizing \u2014 too large</option>\n    <option>Not as expected</option>\n    <option>Fault or damage</option>\n    <option>Changed my mind</option>\n    <option>Other</option>\n  </select>\n\n  <label class=\"visually-hidden\" for=\"ReturnForm-body\">Anything else we should know</label>\n  <textarea rows=\"10\" id=\"ReturnForm-body\" class=\"contact-form__input contact-form__input--textarea\"\n    name=\"contact[body]\" placeholder=\"Anything else we should know\">{{ form.body }}</textarea>\n\n  <button type=\"submit\" class=\"button\">Send request</button>\n{%- endform -%}\n</div>"
          }
        }
      },
      "block_order": [
        "return_form"
      ],
      "name": "t:names.contact_form",
      "settings": {
        "content_direction": "column",
        "vertical_on_mobile": true,
        "horizontal_alignment": "flex-start",
        "vertical_alignment": "center",
        "align_baseline": false,
        "horizontal_alignment_flex_direction_column": "center",
        "vertical_alignment_flex_direction_column": "center",
        "gap": 32,
        "section_width": "page-width",
        "section_height_custom": 50,
        "background_media": "none",
        "background_color": "{{ settings.color_palette.background }}",
        "video_position": "cover",
        "background_image_position": "cover",
        "border": "none",
        "border_width": 1,
        "border_opacity": 100,
        "border_radius": 0,
        "toggle_overlay": false,
        "overlay_color": "#00000026",
        "overlay_style": "solid",
        "gradient_direction": "to top",
        "padding-block-start": 32,
        "padding-block-end": 84
      }
    }
  },
  "order": [
    "main",
    "form"
  ]
}